# Base de donnees
DATABASE_URL=postgresql+psycopg://kuma:kuma@localhost:5432/kuma

# Securite
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Yousign
YOUSIGN_API_URL=https://api-sandbox.yousign.app/v3
YOUSIGN_API_KEY=change-me

# Stockage local chiffre des PDF contractuels (disque persistant Render)
STORAGE_PATH=./storage/contracts
# Cle Fernet (generer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
STORAGE_ENCRYPTION_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173

# Environnement
ENVIRONMENT=development

# Bootstrap admin (optionnel) : cree un compte admin au demarrage si aucun n'existe.
# Laisser vide pour desactiver.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrateur
